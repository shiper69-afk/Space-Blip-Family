; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Are We There Yet? (Galaxy edition)"
config/description="A comedy point-and-click about a family stuck on The Millennium Mini Van."
run/main_scene="res://game/start/start_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Globals="*uid://bff8xxxqel4g1"
GameFlow="*res://game/autoloads/game_flow.gd"
GameMenu="*res://game/autoloads/game_menu.tscn"
Cursor="*uid://c2pqh7ajiuiy0"
E="*uid://rda8wggldt5o"
R="*uid://ctrhqan6jjm3j"
C="*uid://dgujebwq54ddd"
I="*uid://dfq2bo55xv5ob"
D="*uid://ccqribyqj7i4w"
A="*uid://dw8xobgauaewl"
G="*uid://blk6nfpfiqrd2"
T="*uid://30lm6k5s368s"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/popochiu/editor/gizmos/plugin.cfg", "res://addons/popochiu/editor/importers/plugin.cfg", "res://addons/popochiu/plugin.cfg")

